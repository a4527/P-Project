# Naver APIs
SMARTPARKING_NAVER_MAP_CLIENT_ID=
SMARTPARKING_NAVER_SEARCH_CLIENT_ID=
SMARTPARKING_NAVER_SEARCH_CLIENT_SECRET=

# Optional Gemini API key. If empty, Ollama fallback is used.
SMARTPARKING_GEMINI_API_KEY=

# Auth. Docker Compose has a development default; override this for real deployments.
SMARTPARKING_JWT_SECRET=

# PostgreSQL. Defaults are for this project's docker-compose.yml.
SMARTPARKING_DATASOURCE_DB=smartparking
SMARTPARKING_DATASOURCE_USERNAME=smartparking
SMARTPARKING_DATASOURCE_PASSWORD=smartparking

# MinIO. Defaults are for this project's docker-compose.yml.
SMARTPARKING_STORAGE_BUCKET=smartparking-minio-assets
SMARTPARKING_STORAGE_ACCESS_KEY=minioadmin
SMARTPARKING_STORAGE_SECRET_KEY=minioadmin
